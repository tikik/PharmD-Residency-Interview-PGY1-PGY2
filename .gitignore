# ======================
# Virtual Environments (explicit)
# ======================
pharmd_venv/
.pharmd_venv/

venv/
env/
ENV/
.venv/
.env/

# ======================
# Python bytecode & artifacts
# ======================
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ======================
# Build & Packaging (PyInstaller)
# ======================
build/
dist/
*.spec

# ======================
# Never commit binaries or system folders
# (but scoped to root to avoid overblocking)
# ======================
/pharmd_venv/bin/
/pharmd_venv/lib/
/pharmd_venv/include/
/pharmd_venv/Scripts/

/venv/bin/
/venv/lib/
/venv/include/
/venv/Scripts/
